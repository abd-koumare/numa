FROM node:24.6-alpine AS build

WORKDIR /workspace
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.29.1-alpine
COPY docker/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 docker/frontend/40-numa-runtime-config.sh /docker-entrypoint.d/40-numa-runtime-config.sh
COPY --from=build /workspace/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
