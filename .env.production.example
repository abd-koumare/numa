NUMA_VERSION=1.0.0
NUMA_DOMAIN=numa.exemple.local
NUMA_PUBLIC_URL=https://numa.exemple.local
NUMA_TLS_CONFIG=tls internal
NUMA_CERT_DIR=./certificates
NUMA_DATA_MODE=api
NUMA_AUTH_MODE=oidc
NUMA_API_URL=/api/v1
NUMA_OIDC_CLIENT_ID=numa-web

POSTGRES_DB=numa
POSTGRES_USER=numa
POSTGRES_PASSWORD=CHANGE_ME
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=numa.exemple.local,api
CSRF_TRUSTED_ORIGINS=https://numa.exemple.local
CORS_ALLOWED_ORIGINS=https://numa.exemple.local
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
NUMA_SETUP_TOKEN=CHANGE_ME
NUMA_ENCRYPTION_KEY=CHANGE_ME_FERNET
NUMA_BACKUP_ENCRYPTION_KEY=CHANGE_ME_FERNET
NUMA_BACKUP_DIR=/var/lib/numa/backups
NUMA_BACKUP_S3_BUCKET=numa-backups
NUMA_BACKUP_S3_PREFIX=backups/
NUMA_BACKUP_KEEP_LOCAL_AFTER_S3=true
NUMA_BACKUP_MAX_EXTRACTED_BYTES=1099511627776
NUMA_BACKUP_MAX_MEMBERS=1000000
NUMA_BACKUP_MANIFEST_MAX_BYTES=33554432

MINIO_ROOT_USER=numa
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=numa-documents
USE_S3=true

KC_BOOTSTRAP_ADMIN_USERNAME=numa-keycloak-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_USERNAME=numa-keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_REALM=numa
KEYCLOAK_ADMIN_VERIFY_TLS=false
NUMA_BOOTSTRAP_ADMIN_USERNAME=numa.admin
NUMA_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TEMPORARY

OIDC_AUDIENCE=numa-api
OIDC_WEB_CLIENT_ID=numa-web
OIDC_ALLOW_DEV_AUTH=false
NUMA_SEED_DEMO=false
NUMA_USE_RUNSERVER=false
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
CELERY_WORKER_CONCURRENCY=4
NUMA_TIMEZONE=UTC
LOG_LEVEL=INFO

MAX_UPLOAD_SIZE=26214400
OCR_LANGUAGES=fra+eng
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemple.local
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=NUMA <numa@exemple.local>
